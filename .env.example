# One key enables the conversational agent. Without any key the app still runs:
# planners use the plan panel and the HTTP API; the chat panel says the agent is offline.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides
# OPENAI_MODEL=gpt-5.6-luna        # used through the Responses API (function tools)
# ANTHROPIC_MODEL=claude-sonnet-5
# AGENT_TURNS_PER_HOUR=30          # per browser session
# AGENT_TURNS_PER_DAY=3000         # whole deployment
# PORT=8000
